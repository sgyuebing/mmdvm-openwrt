+                    loss = "0"
+                    -- TODO: RSSI
+                else
+                    loss = string.trim(string.sub(loss or "", 1, -14))
+                    if count_tokens >= 5 then
+                        ber = string.trim(string.sub(linetokens[5] or "", 6, -2))
+
+                    end
+                end
+
+            end
+
+            local timestamp = string.sub(logline, 4, 22)
